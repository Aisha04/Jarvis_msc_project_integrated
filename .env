# ---- Your name (used in the welcome and briefing)
JARVIS_NAME=Aishani
JARVIS_SHORT_NAME=Aish

# 1 = always listening for "Hello Jarvis", 0 = only when you press Space / click the orb
JARVIS_ALWAYS_LISTEN=1

# ---- Which AI to use: gemini (free) | claude (paid) | ollama (free, runs on your PC)
JARVIS_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Only needed if JARVIS_PROVIDER=claude
ANTHROPIC_API_KEY=

# Optional: override the model (leave blank for the default)
JARVIS_MODEL=

# Optional: pin your location instead of IP lookup
JARVIS_LAT=-20.298
JARVIS_LON=57.478
JARVIS_CITY=Vacoas

# Voice: en-GB-RyanNeural, en-GB-ThomasNeural, en-US-AndrewNeural, en-GB-SoniaNeural ...
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_VOICE_RATE=+4%
JARVIS_VOICE_PITCH=-4Hz
